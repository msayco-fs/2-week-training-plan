{
  "ConnectionStrings": {
    "Reporting": "",
    "Hangfire": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PerCaller": {
      "PermitLimit": 60,
      "Window": "00:01:00"
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Reporting": {
    "QuarterlyOutput": {
      "Directory": "reports/quarterly"
    }
  },
  "Security": {
    "TenantDenialAlert": {
      "Threshold": 5,
      "Window": "00:05:00"
    }
  }
}
