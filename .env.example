# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml only.

# Password for the local SQL Server container's sa login. Dev only.
# At least 8 characters with 3 of: upper case, lower case, digits, symbols.
# Avoid ; and $ because the value goes into a connection string.
MSSQL_SA_PASSWORD=

# Folder that holds your .NET user secrets, mounted read-only into the API so
# `dotnet user-jwts` tokens work. Forward slashes work on Windows too.
#   Windows:      C:/Users/<you>/AppData/Roaming/Microsoft/UserSecrets
#   macOS/Linux:  /home/<you>/.microsoft/usersecrets  (or /Users/<you>/... on macOS)
USER_SECRETS_DIR=
